#!/usr/bin/env python3
"""Drop-in for `unswbc run MAP A B --sandbox --seed S -v -o OUT` that plays C/C++ (wasm) bots
with cppjudge, the C++ host in this directory. Anything else -- a Python bot, a command other
than `run`, a run without --sandbox, an option cppjudge doesn't take, or a bot whose imports
cppjudge lacks (it exits 3 before printing anything) -- goes to the official `unswbc`.

The bots are built and metered with unswbc's own Python (clangtool.build, sandbox._metered),
cached exactly where the official judge caches them, so both judges share one cache.
"""
from __future__ import annotations

import hashlib
import os
import pathlib
import shutil
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
BINARIES = [HERE / "build" / "cppjudge", HERE / "cppjudge", pathlib.Path("/opt/cppjudge/cppjudge")]
# The unswbc 1.2.7 files cppjudge is a port of (and the engine it hosts). When unswbc changes any
# of them, games go to the official judge until cppjudge is checked against the new version and
# these are updated: a stale port must never quietly play by old rules.
PORTED = {
    "run.py": "6e24178f6772f06455ce97c637afd46380e9b1b5a8218b1aa782c8a50adefc52",
    "turn.py": "2150efad3fd75ba6e7efc6dc51b4f89817fada4c1d0e6fd47f055efe8322312c",
    "sandbox.py": "a318cb556a2b8419e2bf246dbed68a718eb8d6ff24b7189aad3929d169b262fe",
    "bot.py": "9b7d178c167e42f968ca89a1d0d86d9d151bf63e042f2c63ab2ff9df23f77ac5",
    "engine.py": "7158bde232f6bf5400e047ed4103451a7e708a0c9f7df9b857b5ad129214b442",
    "metering.py": "175193a973585d2e10d920b1d0b97c9d4f1577b4050829564be45a6e16fbee8d",
    "zygote_host.py": "48b8b7bab7f7fdec85ad500dccdb6e242aec1e9ddcc61d16a800b8495d42603c",
    "unswbc_engine.wasm": "26e68680e45eb0f221db702aead9eefde776c2ad2ba066f4ddf8c12500c6a546",
}
FLAGS = {"-v", "--verbose", "--sandbox", "--no-replay", "--no-retry"}
VALUED = {"-o", "--output", "--replay", "--seed"}


def official(argv: list[str], why: str) -> int:
    # arena/runner.py reads this line to record which judge played the game
    print(f"unswbc-cpp: official judge ({why})", file=sys.stderr, flush=True)
    if "--no-retry" in argv:                # the arena's judge: unswbc minus the retry
        from arena.strictjudge import main as strict
        return strict([a for a in argv if a != "--no-retry"])
    exe = shutil.which("unswbc")
    if exe is None:
        from unswbc.cli import main
        return main(argv)
    os.execv(exe, [exe, *argv])


def ported() -> bool:
    """Whether the installed unswbc is the one cppjudge was ported from."""
    import unswbc
    here = pathlib.Path(unswbc.__file__).parent
    try:
        return all(hashlib.sha256((here / f).read_bytes()).hexdigest() == sha for f, sha in PORTED.items())
    except OSError:
        return False


def cache_dir() -> pathlib.Path:
    # unswbc.sandbox._cache_dir, without importing wasmtime
    home = os.environ.get("XDG_CACHE_HOME") or os.environ.get("LOCALAPPDATA")
    return (pathlib.Path(home) if home else pathlib.Path.home() / ".cache") / "unswbc"


def built(bot: pathlib.Path) -> pathlib.Path:
    """clangtool.build(bot): the cached wasm when it's there, else the official build."""
    from unswbc import clangtool
    found = clangtool.sources(bot)
    stamp = hashlib.sha256(
        repr([clangtool.DRIVER_FLAGS, clangtool.LINK_FLAGS, clangtool.LINK_TAIL,
              [p.as_posix() for p in found]]).encode()
        + b"".join((bot / p).read_bytes() for p in found)).hexdigest()[:32]
    cached = cache_dir() / "wasmbots" / f"{bot.resolve().name}-{stamp}.wasm"
    return cached if cached.is_file() else pathlib.Path(clangtool.build(bot))


def metered(wasm: pathlib.Path) -> pathlib.Path:
    """sandbox._metered(wasm), with its cache looked up first."""
    blob = wasm.read_bytes()
    if b"wasmer_metering_remaining_points" in blob:
        return wasm
    priced = cache_dir() / f"{wasm.stem}-{hashlib.sha256(blob).hexdigest()[:32]}-metered.wasm"
    if priced.is_file():
        return priced
    from unswbc.sandbox import _metered
    return pathlib.Path(_metered(wasm))


def resolve(arg: str) -> pathlib.Path | None:
    """run._resolve(arg, sandbox=True) for the wasm cases; None for anything else."""
    path = pathlib.Path(arg)
    if path.is_file():
        return path if path.suffix == ".wasm" else None
    if path.is_dir() and not (path / "main.py").is_file():
        from unswbc import clangtool
        if clangtool.sources(path):
            return built(path)
    return None


def main(argv: list[str]) -> int:
    if not argv or argv[0] != "run" or "--sandbox" not in argv:
        return official(argv, "not a sandboxed run")
    positional, options, i = [], [], 1
    while i < len(argv):
        a = argv[i]
        if a in FLAGS:
            options.append(a)
        elif a in VALUED and i + 1 < len(argv):
            options += [a, argv[i + 1]]
            i += 1
        elif a.startswith("-"):
            return official(argv, "an option cppjudge doesn't take")          # --no-logs and friends: not ported
        else:
            positional.append(a)
        i += 1
    if len(positional) != 3 or not pathlib.Path(positional[0]).is_file():
        return official(argv, "not MAP A B")
    if not ported():
        return official(argv, "unswbc changed since cppjudge was ported")
    binary = next((b for b in BINARIES if b.is_file()), None)
    if binary is None:
        return official(argv, "no cppjudge binary")
    names = positional[1:]
    try:
        wasms = [resolve(n) for n in names]
    except Exception:
        return official(argv, "a bot didn't build")              # let the official judge report the build failure
    if None in wasms:
        return official(argv, "not a wasm bot")
    wasms = [metered(w) for w in wasms]
    import unswbc
    engine = pathlib.Path(unswbc.__file__).with_name("unswbc_engine.wasm")
    sys.stdout.flush()
    code = subprocess.call([str(binary), "run", positional[0], names[0], names[1],
                            "--wasm-a", str(wasms[0]), "--wasm-b", str(wasms[1]),
                            "--engine", str(engine), *options])
    if code == 3:
        return official(argv, "a bot needs imports cppjudge lacks")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
