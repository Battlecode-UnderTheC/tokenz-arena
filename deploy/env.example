# Copy to .env next to compose.yaml (not committed).
TS_AUTHKEY=tskey-auth-...          # a Tailscale auth key from the admin console (reusable, tagged or not)
TS_HOSTNAME=tokenz-arena           # -> https://tokenz-arena.<tailnet>.ts.net
ARENA_DATA=/home/syeyoung/tokenz-arena-data      # holds arena.toml, submissions, games, replays
ARENA_SECRETS=/home/syeyoung/.config/tokenz-arena # unswbc-key (mode 600), read-only in the container
BCWEB_DIR=../bcweb
ARENA_CACHE=/home/syeyoung/.cache/tokenz-arena-unswbc  # judge toolchain + wasm build cache
ARENA_UID=1021                     # `id -u` on the host
ARENA_GID=1021
